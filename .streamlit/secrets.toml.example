# Copy to secrets.toml for local use. On Streamlit Cloud paste the same lines into
# App settings -> Secrets. Never commit secrets.toml.

GEMINI_API_KEY = "paste_your_key_here"
# Optional: force one model (default: tries several gemini flash models)
# GEMINI_MODEL = "gemini-flash-latest"

# Needed so the update button commits data/accidents.json back to GitHub
# (without these, updates are lost when Streamlit Cloud restarts the app).
# Token: fine-grained "Contents: Read and write" on the repo, or classic "repo" scope.
# GITHUB_TOKEN = "ghp_..."
# GITHUB_REPO = "owner/repo"
# GITHUB_BRANCH = "main"

# Optional: require a password before the update button works
# UPDATE_PASSWORD = "choose-a-password"
